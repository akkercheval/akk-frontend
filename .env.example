# Copy this file to .env and fill in real values. .env is git-ignored.
# Base URL of the AkkWebService backend API (leave blank to use same-origin).
VITE_API_URL=
# Base URL for the cookie-cutter images repository (raw GitHub content).
VITE_COOKIE_CUTTER_IMAGE_BASE=https://raw.githubusercontent.com/akkercheval/akk-cookie-cutter-images/main
