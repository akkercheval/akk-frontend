# Dependencies (reinstalled inside the image via `npm ci`)
node_modules

# Build output (regenerated inside the image via `npm run build`)
dist
dist-ssr

# Git / CI
.git
.gitignore
.github

# Secrets / local env (never bake into the image)
.env
.env.*
!.env.example

# Editor / OS cruft
.vscode
.idea
.DS_Store
*.log

