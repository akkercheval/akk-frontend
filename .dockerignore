# Dependencies (reinstalled inside the image via `npm ci`)
node_modules

# Build output (regenerated inside the image via `npm run build`)
dist
dist-ssr

# Git / CI
.git
.gitignore
.github

# Secrets / local env (never bake into the image)
.env
.env.*
!.env.example

# Editor / OS cruft
.vscode
.idea
.DS_Store
*.log

# Design/reference material NOT imported by the build -> safe to exclude.
melda/
style-guide/

# NOTE: gypsa/, forest/, lotro/, and some top-level *.md files ARE imported by
# src/ at build time (Vite ?raw / ?url), so they must remain in the build
# context. .gitignore already keeps only the needed subset in the repo, so the
# CI checkout is already lean. Do not exclude them here or the build fails.
